{
  "name": "@zunialab/sdk-web",
  "version": "0.1.1",
  "description": "Connect a web dApp to the Zunia wallet: browser extension, phone by QR code, or WalletConnect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zunia-Lab/zunia-sdk.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/Zunia-Lab/zunia-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zunia-Lab/zunia-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./connect-button.css": "./dist/connect-button.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node -e \"require('node:fs').copyFileSync('src/connect-button.css', 'dist/connect-button.css')\"",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@zunialab/sdk-core": "workspace:*",
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "@walletconnect/sign-client": "^2.17.0"
  },
  "peerDependenciesMeta": {
    "@walletconnect/sign-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cosmjs/amino": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.1",
    "cosmjs-types": "^0.11.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "zunia",
    "cosmos",
    "wallet",
    "dapp",
    "walletconnect",
    "cosmjs"
  ],
  "sideEffects": [
    "*.css"
  ]
}
