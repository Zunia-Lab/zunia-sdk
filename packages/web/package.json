{
  "name": "@zunialab/sdk-web",
  "version": "0.1.0",
  "description": "Browser SDK for connecting dApps to the Zunia extension (window.zunia)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zunia-Lab/zunia-sdk.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/Zunia-Lab/zunia-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zunia-Lab/zunia-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connect-button.css": "./src/connect-button.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zunialab/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "@walletconnect/sign-client": "^2.17.0"
  },
  "peerDependenciesMeta": {
    "@walletconnect/sign-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
