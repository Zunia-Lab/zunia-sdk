{
  "name": "@zunialab/interchain",
  "version": "0.1.0",
  "description": "Dependency-free IBC engine for Zunia: channel discovery, denom unwinding, PFM/ibc-hooks memos, cross-chain swaps and NFTs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zunia-Lab/zunia-sdk.git",
    "directory": "packages/interchain"
  },
  "homepage": "https://github.com/Zunia-Lab/zunia-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zunia-Lab/zunia-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
