{
  "name": "@zunialab/sdk-core",
  "version": "0.1.0",
  "description": "Types, sign-in messages, server-side verification and zunia.connect.v2 crypto for Zunia wallet integrations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zunia-Lab/zunia-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Zunia-Lab/zunia-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zunia-Lab/zunia-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "test-vectors",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@cosmjs/amino": "^0.39.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "keywords": [
    "zunia",
    "cosmos",
    "wallet",
    "sign-in",
    "adr-036",
    "cosmjs"
  ],
  "sideEffects": false
}
