{
  "name": "@zunialab/sdk-react",
  "version": "0.1.1",
  "description": "React hooks and components for connecting to the Zunia wallet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zunia-Lab/zunia-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Zunia-Lab/zunia-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zunia-Lab/zunia-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external @zunialab/sdk-web --external @zunialab/sdk-core",
    "dev": "tsup src/index.ts --format esm --dts --watch --external react --external @zunialab/sdk-web --external @zunialab/sdk-core",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.tsx\""
  },
  "dependencies": {
    "@zunialab/sdk-core": "workspace:*",
    "@zunialab/sdk-web": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "zunia",
    "cosmos",
    "wallet",
    "react",
    "dapp"
  ],
  "sideEffects": false
}
